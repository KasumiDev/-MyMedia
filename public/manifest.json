{
  "manifest_version": 3,
  "name": "Fansly MyMedia (Feasibility Spike)",
  "version": "0.1.0",
  "description": "Tests authenticated MyMedia access for the currently signed-in Fansly user.",
  "permissions": ["scripting", "downloads"],
  "host_permissions": ["https://fansly.com/*"],
  "background": {
    "service_worker": "assets/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://fansly.com/*"],
      "js": ["assets/content.js"],
      "run_at": "document_start"
    }
  ]
}
